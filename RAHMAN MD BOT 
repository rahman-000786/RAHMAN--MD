  </section>

  <section class="layout">
    <div class="card">
      <div class="card-head"><div class="icon">⌁</div><div><h2>Pair your WhatsApp</h2><p class="sub">Enter your number to receive a pairing code.</p></div></div>
      <form id="pairForm" novalidate>
        <label class="label" for="countryCode">Phone number</label>
