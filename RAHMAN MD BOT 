    const local=$("phoneNumber").value.replace(/\D/g,"");
    const number=(country+local).replace(/\D/g,"");
    if(number.length<10||number.length>15){toast("Please enter a valid phone number with country code (10–15 digits).",true);return}
    const button=$("pairButton");button.disabled=true;button.textContent="Generating…";
    try{
      const response=await api("/api/pair",{method:"POST",body:JSON.stringify({number,brand:{name:CONFIG.brandName,banner:CONFIG.bannerImageUrl,owner:CONFIG.ownerNumber,ownerName:CONFIG.ownerName,channel:CONFIG.channelLink}})});
      let data={};try{data=await response.json()}catch{}
      if(!response.ok){const messages={400:"Invalid phone number. Please check and try again.",429:"A pairing is already in progress. Please wait a moment.",503:"Pairing capacity is full. Please try again later.",500:"Could not generate a pairing code. Please try again."};throw Error(data.error||messages[response.status]||"Could not generate a pairing code.")}
      if(!data.code)throw Error(data.error||"The server did not return a pairing code.");
      showCode(data.code,data.expiresIn??120);toast("Pairing code generated successfully.");
    }catch(error){toast(error instanceof TypeError?"Could not reach server, please try again":error.message||"Could not reach server, please try again",true)}
    finally{button.disabled=false;button.textContent="Get Pairing Code  →"}
  });
  $("copyButton").addEventListener("click",async()=>{
    if(!currentCode)return;
    try{await navigator.clipboard.writeText(currentCode);toast("Pairing code copied.")}
    catch{const area=document.createElement("textarea");area.value=currentCode;document.body.appendChild(area);area.select();try{document.execCommand("copy");toast("Pairing code copied.")}catch{toast("Copy failed. Please select the code manually.",true)}area.remove()}
  });
})();
</script>
</body>
</html>
