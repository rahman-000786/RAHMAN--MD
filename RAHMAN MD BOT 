        </div>
        <button class="primary" id="pairButton" type="submit">Get Pairing Code&nbsp; →</button>
      </form>
      <div class="result" id="resultBox" aria-live="polite">
        <div class="result-top"><span class="result-title">Your pairing code</span><span class="timer" id="countdown">02:00 remaining</span></div>
